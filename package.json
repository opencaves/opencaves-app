{
  "name": "opencaves-app",
  "version": "1.0.0-beta-14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --prefix none \"firebase --debug emulators:start --import=./.emulator-data\" \"vite\" \"node scripts/emulator-autosave.js\"",
    "serve": "serve -p 4000 -s build",
    "build": "node scripts/map-layer/build-tiles.js --check && vite build && vite build --ssr src/entry-server.jsx",
    "build:tiles": "node scripts/map-layer/build-tiles.js --build",
    "lint:jsdoc": "eslint src functions/js --max-warnings 0",
    "typecheck": "tsc -p jsconfig.check.json",
    "deploy": "firebase deploy",
    "deploy:beta": "firebase hosting:channel:deploy beta",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">= 20"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not safari < 10",
      "not chrome < 51",
      "not android < 5",
      "not ie < 12"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "safari >= 14"
    ]
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "@emotion/cache": "^11.14.0",
