{
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "maxNodeModuleJsDepth": 0,
    "resolveJsonModule": true,
    "types": ["vite/client", "vite-plugin-svgr/client"]
  },
  "include": ["src/utils/**/*.js", "src/services/**/*.js", "src/services/**/*.jsx", "src/models/**/*.js", "src/config/**/*.js", "src/redux/**/*.js", "src/redux/**/*.jsx", "src/hooks/**/*.js", "src/hooks/**/*.jsx", "src/components/auth/**/*.jsx", "src/components/auth/**/*.js", "src/types.js", "src/global.d.ts", "src/theme/mui-theme.d.ts", "src/custom-elements.d.ts"]
}
