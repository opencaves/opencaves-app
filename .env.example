# The app's settings, read by Vite (only VITE_* variables reach the app).
# Copy to .env and fill in; .env is not in git. The app's version comes from
# package.json (vite.config.js), not from here.
VITE_APP_NAME=OpenCaves

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_LOCATION=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mapbox public token (the map; also read by scripts/map-layer's overlays)
VITE_MAPBOX_ACCESS_TOKEN=

# Google Geocoding API key (the address shown in a cave's details)
VITE_GOOGLE_GEOCODING_API_KEY=

# App Check's reCAPTCHA v3 site key (Firebase console > App Check > the web
# app). Empty: App Check is off. See docs/app-check.md.
VITE_RECAPTCHA_SITE_KEY=
