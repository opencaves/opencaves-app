    "@milkdown/utils": "^7.22.2",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@reduxjs/toolkit": "^2.13.0",
