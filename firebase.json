{
  "hosting": [
    {
      "target": "opencaves",
      "public": "build",
      "predeploy": "node scripts/check-ssr-build.js --check",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=()" },
            { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://www.gstatic.com https://www.googletagmanager.com https://unpkg.com https://www.google.com; style-src 'self' 'unsafe-inline' https://api.mapbox.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://firebasestorage.googleapis.com https://storage.googleapis.com; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.run.app https://api.mapbox.com https://events.mapbox.com https://*.tiles.mapbox.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' https://www.google.com https://recaptcha.google.com https://opencaves.firebaseapp.com https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.facebook.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" }
          ]
        },
        {
          "source": "/service-worker.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/!(*.*)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/app.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/map/*",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }]
        },
        {
          "source": "/",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }]
        },
        {
          "source": "/@(caves|sistemas)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }]
        },
        {
          "source": "/@(caves|sistemas)/*",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }]
        },
        {
          "source": "/@(caves|sistemas)/edit",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/api/address/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=2592000" }]
        },
        {
          "source": "/tiles/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
        },
        {
          "source": "/tiles/caves/*.json",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/assets/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ],
      "redirects": [
        {
          "source": "/areas/:slug",
          "destination": "/caves#:slug",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/",
          "function": "indexPages"
        },
        {
          "source": "/sitemap.xml",
          "function": "sitemap"
        },
        {
          "source": "/map/*",
          "function": "cavePage"
        },
        {
          "source": "/caves/edit",
          "destination": "/app.html"
        },
        {
          "source": "/sistemas/edit",
          "destination": "/app.html"
        },
        {
          "source": "/caves",
          "function": "indexPages"
        },
        {
          "source": "/caves/*",
          "function": "indexPages"
        },
        {
          "source": "/sistemas",
          "function": "indexPages"
        },
        {
          "source": "/sistemas/*",
          "function": "indexPages"
        },
        {
          "source": "/api/address/*",
          "function": "caveAddress"
        },
        {
          "source": "**",
          "destination": "/app.html"
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "database": {
      "port": 9000
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true,
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "pubsub": {
      "port": 8085
    }
  },
  "functions": [
    {
      "source": "functions/js",
      "codebase": "js",
      "predeploy": "node scripts/check-ssr-build.js --check",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "extensions": {}
}
