{
  "name": "@opencaves/firebase-js-functions",
  "version": "1.0.0",
  "description": "Cloud js Functions for OpenCaves",
  "scripts": {
    "lint": "eslint .",
    "dev": "firebase emulators:start --import=.\\.emulator-data --export-on-exit=.\\.emulator-data --debug",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "type": "module",
  "dependencies": {
    "@googleapis/sheets": "^18.0.1",
    "dompurify": "^3.4.16",
    "exif-parser": "^0.1.12",
    "exifr": "^7.1.3",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "jsdom": "^30.1.2",
    "mkdirp": "^3.0.1",
    "pdf-into-svg": "^1.0.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.4",
    "unique-push-id": "^1.0.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "eslint": "^10.11.0"
  },
  "private": true
}
