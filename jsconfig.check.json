{
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "maxNodeModuleJsDepth": 0,
    "resolveJsonModule": true,
    "types": ["vite/client", "vite-plugin-svgr/client"]
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/types.js", "src/global.d.ts", "src/theme/mui-theme.d.ts", "src/custom-elements.d.ts"]
}
