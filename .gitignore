# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist

# misc
.DS_Store
*OLD*
* - Copie*
* copy.*
npm-debug.log*

# OpenCaves related
/.firebase
# *.rules - firestore.rules and storage.rules are tracked: they are the app's access control
/cenotes
firebase-export-*
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.log*
# Cloud Functions log dumps (firebase functions:log > logs.json): they hold
# users' emails, IPs and signed URLs
logs.json
/.vscode
/_data

# Python bytecode (maps-import scripts import each other)
__pycache__/

# The cave layer's vector tiles: built by `npm run build:tiles` from _data/ (not in git)
/public/tiles/

# Local values of the Cloud Functions secrets (the emulator reads them): never committed.
.secret.local

# Firebase Auth exports (firebase auth:export): accounts and password hashes, never committed
users.json
